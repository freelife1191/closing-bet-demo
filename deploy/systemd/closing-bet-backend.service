[Unit]
Description=Closing Bet Demo Backend (Gunicorn)
After=network-online.target
Wants=network-online.target

# StartLimit* 는 [Unit] 에 둔다. 옛 이름 StartLimitInterval=/StartLimitBurst= 는 [Service]
# 에서도 호환용으로 읽히지만, 새 이름 StartLimitIntervalSec= 는 [Service] 에 두면
# "Unknown key name" 경고와 함께 무시된다. (서버본 주석은 「[Service] 에 두면 조용히
# 무시한다」였으나 사실과 달라 이 줄만 고쳤다.)
# 2026-09-22 [U5]: 무제한(0)이던 것을 유한하게 바꿨다. 포트 소유권 충돌로 433회를
# 재시작하며 로그와 CPU 를 태운 사고가 있었다. 실패는 멈추고 드러나야 한다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/app/closing-bet-demo

# 2026-09-22 [U1]: services/scheduler.lock 을 지우던 ExecStartPre 를 제거했다.
# services/scheduler.py 가 flock 으로 리더를 뽑는데, 살아 있는 워커가 쥔 inode 를
# unlink 하면 새 워커가 별도 inode 에 잠금을 따로 얻어 리더가 둘이 될 수 있다.

# 2026-09-22 [U2]: --bind 를 0.0.0.0 에서 127.0.0.1 로 고정했다. 외부 노출은 Caddy 가
# localhost:3500 으로만 하고, Next 는 http://127.0.0.1:5501 로만 Flask 를 부른다
# (next.config.js rewrites, app/api/system/env/route.ts). 0.0.0.0 이면 LAN 에서
# Flask 에 직접 닿아 NextAuth 를 우회할 수 있었다. .env 의 FLASK_HOST 로 되돌릴 수
# 없도록 값을 여기에 박는다.
ExecStart=/bin/bash -lc 'set -a; [ -f .env ] && . ./.env; set +a; exec ./venv/bin/gunicorn flask_app:app --bind 127.0.0.1:${FLASK_PORT:-5501} --workers 2 --threads 8 --timeout 120'
Restart=always
RestartSec=5

# 2026-09-22 [U4 미채택]: journal 로 옮기지 않는다. 로그 폭주는 위 StartLimitBurst 가
# 다섯 번에서 멈추고, logs/backend.log 를 로그 위치로 적은 CLAUDE.md/AGENTS.md/README.md/
# restart_all.sh 를 두 갈래로 가르지 않기 위해서다. 얻는 것이 분리의 깔끔함뿐이다 ([INFRA-075]).
StandardOutput=append:%h/app/closing-bet-demo/logs/backend.log
StandardError=append:%h/app/closing-bet-demo/logs/backend.log

[Install]
WantedBy=default.target
