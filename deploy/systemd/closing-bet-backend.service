# 운영 서버의 ~/.config/systemd/user/ 에 두는 유닛이다. 이 파일이 저장소 밖에만 있던
# 동안 [INFRA-055] 이후의 코드와 어긋난 채 방치되어 재시작 루프를 일으켰으므로
# 여기서 함께 관리한다. 적용 절차는 같은 디렉터리의 README.md 에 있다.

[Unit]
Description=Closing Bet Demo Backend (Gunicorn)
After=network-online.target
Wants=network-online.target
# 실패는 멈추고 드러나야 한다. 상한이 없으면 5초마다 영원히 재시작하며 로그와 CPU 를
# 태우고, 정작 원인은 그 로그에 묻힌다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/app/closing-bet-demo
# services/scheduler.lock 을 지우지 않는다. 지우면 돌고 있는 워커는 unlink 된 inode 에
# 잠금을 쥔 채 남고 새 워커는 새 inode 에서 잠금을 따로 얻으므로, 스케줄러 리더가 둘이
# 될 수 있다. services/scheduler.py 의 _acquire_scheduler_lock 을 참고한다.
# 바인딩은 loopback 으로 고정한다. 앞단의 Caddy 만 연결하면 되며, 근거는 루트 CLAUDE.md
# 와 .env.example 의 FLASK_HOST 주석에 있다. .env 의 FLASK_HOST 는 일부러 읽지 않는다.
ExecStart=/bin/bash -lc 'set -a; [ -f .env ] && . ./.env; set +a; exec ./venv/bin/gunicorn flask_app:app --bind 127.0.0.1:${FLASK_PORT:-5501} --workers 2 --threads 8 --timeout 120'
Restart=always
RestartSec=5
# 유닛의 실패 로그를 logs/backend.log 에 덧붙이지 않는다. 정상 서비스 로그와 섞이면
# 어느 쪽이 실제로 돌고 있는 프로세스의 기록인지 구분할 수 없다.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
