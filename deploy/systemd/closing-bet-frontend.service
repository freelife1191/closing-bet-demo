[Unit]
Description=Closing Bet Demo Frontend (Next.js)
After=network-online.target
Wants=network-online.target

# 2026-09-22 [U5]: backend 와 같은 이유로 유한한 상한을 둔다. 823회 재시작한 이력이 있다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/app/closing-bet-demo/frontend
Environment=PATH=/home/ms/n/bin:/usr/local/bin:/usr/bin:/bin

# 2026-09-22 [U3]: `ln -sf ../.env frontend/.env` 를 만들던 ExecStartPre 를 제거했다.
# [INFRA-055] 의 frontend/scripts/run-next.js 가 그 레거시 심링크를 기동 전에 제거하므로
# 매 기동마다 만들고 지우기만 하는 헛수고였다. 환경은 실행기가 루트 .env 에서 채운다.
ExecStart=/bin/bash -lc 'set -a; [ -f ../.env ] && . ../.env; set +a; export PORT=${FRONTEND_PORT:-3500}; exec /home/ms/n/bin/npm run dev'
Restart=always
RestartSec=5

# 2026-09-22 [U4 미채택]: 위 backend 유닛의 같은 주석을 참고. journal 로 옮기지 않는다.
StandardOutput=append:%h/app/closing-bet-demo/logs/frontend.log
StandardError=append:%h/app/closing-bet-demo/logs/frontend.log

[Install]
WantedBy=default.target
