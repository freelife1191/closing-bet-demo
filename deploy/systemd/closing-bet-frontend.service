# 운영 서버의 ~/.config/systemd/user/ 에 두는 유닛이다. 적용 절차는 같은 디렉터리의
# README.md 에 있다.

[Unit]
Description=Closing Bet Demo Frontend (Next.js)
After=network-online.target closing-bet-backend.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/app/closing-bet-demo/frontend
# frontend/.env -> ../.env 심링크를 만들지 않는다. [INFRA-055] 의 실행기가 그 레거시
# 심링크를 기동 전에 제거하므로(frontend/scripts/run-next.js), 여기서 다시 만들면
# 5초마다 서로 되돌리는 싸움이 된다. 루트 설정은 실행기가 직접 읽어 전달한다.
ExecStart=/bin/bash -lc 'set -a; [ -f ../.env ] && . ../.env; set +a; export PORT=${FRONTEND_PORT:-3500}; exec /home/ms/n/bin/npm run dev'
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
