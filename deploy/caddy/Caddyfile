# 운영 서버 /etc/caddy/Caddyfile 가운데 이 프로젝트 블록의 기준본입니다. 서버 파일에는 다른 사이트
# 블록도 있습니다. 적용 절차와 함정은 README.md 에 있습니다.

# 사이트 블록이 import 로 가져다 쓰는 압축과 보안 헤더입니다.
(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# 호스트 이름 없이 80 포트로 들어온 요청에는 Caddy 기본 페이지 대신 404 만 돌려줍니다.
:80 {
	respond 404
}

close.highvalue.kr {
	import common
	log {
		output file /var/log/caddy/close.highvalue.kr.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
	# Next 가 신원 경계입니다. Flask(5501)는 loopback 에만 있고 여기서 직접 프록시하지 않습니다.
	reverse_proxy localhost:3500
}
