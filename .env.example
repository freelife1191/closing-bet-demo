# ==============================================================================
# 다른 PC 에 배포할 때 새로 발급하는 값
# ==============================================================================
# 아래 셋은 이 저장소가 스스로 만들어 쓰는 서버 전용 비밀이다. 외부에서 발급받아
# 어디서나 같은 값을 쓰는 API 키와 달리, 다른 PC 로 옮길 때는 복사하지 말고 그 PC
# 에서 새로 만든다. 값을 공유하면 한쪽이 유출될 때 나머지도 함께 뚫리며, 특히
# INTERNAL_IDENTITY_SECRET 을 아는 사람은 아무 이메일로나 유효한 신원 서명을 만들어
# 관리자로 행세하는 것까지 가능하다.
#
#   NEXTAUTH_SECRET            openssl rand -base64 32
#   ADMIN_API_TOKEN            python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   INTERNAL_IDENTITY_SECRET   openssl rand -hex 32
#
# NEXTAUTH_URL 도 복사 대상이 아니다. 운영에서는 실제 https 도메인이어야 하며 그
# 이유는 해당 항목의 주석에 적어 두었다.
#
# 루트 `.env`에 값을 두면 Flask가 읽고, npm 실행기는 허용된 공유 키만 Next에 전달한다.
# 전체 파일을 frontend에 링크하지 않는다. 부모/frontend 환경 파일로 공유 키를 덮으면
# Flask와 값이 어긋날 수 있으므로 두 서버의 신원 키는 일치해야 한다.
#
# 루트 값을 바꾸면 Next와 Flask 워커를 모두 재기동해야 반영된다. 파일을 프로세스
# 환경에 채우는 것은 기동 시점이므로 일부만 재기동하면 요청별 동작이 갈린다.
# INTERNAL_IDENTITY_SECRET 이 비어 있으면 모든 사용자가 익명으로 처리되어 관리자
# 화면과 버튼이 표시되지 않는다. Flask 기동 로그에 누락 경고가 남는다. Next와 Flask에
# 같은 값을 설정하고 두 서비스를 모두 재기동해야 한다.
#
# 이 파일은 추적되는 참조본이므로 실제 값을 적지 않는다. 키를 추가하면 여기에도 함께
# 추가한다.
# ==============================================================================

# === Frontend Config ===
FRONTEND_PORT=3500
# Next 실행 모드. dev 는 next dev(개발 서버), prod 는 기동 때 next build 를 돌린 뒤 next start.
# 운영은 prod 다. dev 서버는 localhost 밖 Origin 의 HMR 연결을 막아 운영 화면이 비어 보인다.
# restart_all.sh 가 이 값을 읽으며 dev·prod 외의 값이면 아무것도 내리지 않고 거부한다. 빈 값은
# 키가 없는 것과 같아 dev 로 뜬다.
# 따옴표 없이 적는다. 적용·되돌리기 절차와 다운타임은 deploy/README.md ([INFRA-076]).
NEXT_MODE=dev

# === Server Config ===
FLASK_DEBUG=true
FLASK_PORT=5501
# Flask 는 Next.js 의 rewrite 로만 트래픽을 받으며 그 대상이 127.0.0.1:5501 이다
# (frontend/next.config.js). loopback 에 묶어 두는 것은 INTERNAL_IDENTITY_SECRET 으로
# 서명하는 신원 헤더의 보호 경계이기도 하다. v2 서명은 메서드와 API pathname,
# 이메일·만료에 묶이며 120초 동안 유효하다. 내부 구간과 서명 비밀은 계속 보호해야 한다.
# 이 저장소는 Next와 loopback Flask의 두 프로세스 운영을 지원한다. Flask만 공개하는
# Procfile 기반 PaaS 배포는 지원하지 않는다. 별도 컨테이너 배포를 구성할 때도 Next를
# 신원 경계로 두고 Flask를 외부에 직접 공개하지 않는다.
# 이 줄에는 값 뒤에 인라인 주석을 붙이지 않는다. restart_all.sh 가 scripts/env_value.sh 로
# 이 값을 읽는데 따옴표도 주석도 벗기지 않으므로 gunicorn 의 --bind 문자열이 깨진다
# ([INFRA-049]). 포트 두 개는 env_port 가 숫자만 받아 큰 소리로 막지만 이 값은 그러지 않는다.
# 운영 서버도 restart_all.sh 로 기동하며, 그 경로는 이 값을 그대로 gunicorn 의 --bind 에 쓴다.
# .env 는 git 이 추적하지 않으므로 이 값을 코드로 강제하지 않는다. 이 한 줄이 loopback 계약의
# 방어선이다 ([INFRA-075]).
# 0.0.0.0 이면 방화벽이 외부를 막아도 같은 LAN 의 다른 호스트가 서버 LAN 주소의 5501 포트로
# Flask 에 직접 닿아 NextAuth 로그인 없이 일반 API 를 부를 수 있다. 2026-09-22 운영 LAN 에서 200
# 응답으로 실측했다. 관리자 경로는 서명된 신원 헤더를 따로 요구하므로 이것만으로 열리지는 않는다.
FLASK_HOST=127.0.0.1

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# === Gemini Auth (Vertex AI 단일 경로) ===
# Gemini 호출은 Vertex AI로 일원화되어 있습니다.
# GOOGLE_APPLICATION_CREDENTIALS에는 서비스 계정 JSON 키 경로를 지정하세요.
# 예) gcloud iam service-accounts keys create secrets/sa.json \
#       --iam-account=<sa>@<project>.iam.gserviceaccount.com
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./secrets/vertex-ai-runtime.json

# === Other AI API Keys ===
OPENAI_API_KEY=your_openai_api_key_here

# === Z.ai Config ===
#LLM_PROVIDER=zai  # zai로 설정시 Gemini 대신 사용됨 (기본값: gemini)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.3-flash
LLM_CONCURRENCY=3  # LLM 분석 병렬 처리 개수 (기본: 5)
LLM_CHUNK_SIZE=10  # 한 번 호출 당 분석할 종목 수 (기본: 5)
LLM_API_TIMEOUT=120  # LLM API 타임아웃 (초)

# === Data Source ===
DATA_SOURCE=krx  # krx, fdr, or both
PRICE_CACHE_TTL=300  # 5 minutes

# === Market Gate Config ===
MARKET_GATE_UPDATE_INTERVAL_MINUTES=30  # Market Gate 및 매크로 지표 업데이트 주기 (분)
SCHEDULER_ENABLED=true # 스케줄러 활성화 여부 (true/false)

# 사용 가능 모델 (Vertex AI 기준)
# gemini-3.8-flash
# gemini-3.7-flash
# gemini-3.5-flash-lite
# gemini-3.6-flash
# gemini-3.1-pro-preview
# gemini-2.5-flash
# gemini-2.5-flash-lite
# gemini-2.5-pro
# === AI Config ===
GEMINI_MODEL=gemini-3.8-flash  # 챗봇용 / 대량 사전 분석
CHATBOT_AVAILABLE_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
AI_CACHE_ENABLED=true

# === Rate Limiting ===
PYKRX_RATE_LIMIT=10  # requests per minute
GEMINI_RATE_LIMIT=10  # requests per minute

# === VCP Signals AI 분석 전용 설정 (멀티 AI 지원) ===
VCP_AI_PROVIDERS=gemini,gpt  # 활성·폴백 허용 목록 (gemini, gpt, zai). Z.ai 폴백을 쓰려면 zai도 포함
VCP_SECOND_PROVIDER=gpt      # 두 번째 AI. gpt 만 지원한다. perplexity 는 [VCP-046] 에서 제거되어 경고와 함께 gpt 로 실행된다(VCP_AI_PROVIDERS 의 perplexity 도 gpt 로 대신하며, OPENAI_API_KEY 가 필요하다). OPENAI_API_KEY 가 없으면 두 번째 자리를 비우고 경고한다 [VCP-048]. engine/config.py 의 기본값과 같게 유지한다
VCP_GEMINI_MODEL=gemini-3.8-flash  # VCP 시그널 분석 (flash 권장)
VCP_GPT_MODEL=gpt-5.6-luna  # GPT 분석용 모델 (check_model_info.py 는 Gemini 전용이라 GPT 는 별도 확인 필요)
VCP_GPT_FALLBACK_MODEL=gpt-5.4-nano  # 429/503 시 전환 모델
VCP_ZAI_FALLBACK_ENABLED=true # Z.ai 폴백 클라이언트 활성화 (호출 조건·허용 provider는 별도)
VCP_ZAI_API_TIMEOUT=180 # Z.ai(OpenAI 호환) 호출 타임아웃(초)

# === Analysis LLM Processing Config ===
## 종가베팅 분석용 (심층 추론 모델 추천)
ANALYSIS_GEMINI_MODEL=gemini-3.8-flash  # Phase 3 의미 합성 (flash 권장)
ANALYSIS_LLM_CONCURRENCY=1
ANALYSIS_LLM_CHUNK_SIZE=2
ANALYSIS_LLM_API_TIMEOUT=120
ANALYSIS_LLM_REQUEST_DELAY=4           # API 호출 간 대기 시간 (초). 429 에러 방지용.

# === Notification Settings ===
NOTIFICATION_ENABLED=false
# 지원 채널: discord, telegram, slack, email
NOTIFICATION_CHANNELS=discord,telegram,email

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# === Google Login ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === NextAuth Config ===
# 로컬: http://localhost:3500 / 프로덕션: https://your-domain.com
#
# 이 값은 로그인 리디렉션 주소일 뿐 아니라, getToken 이 세션 쿠키 이름을 고르는 기준이다.
# https 로 시작하면 __Secure-next-auth.session-token 을, 아니면 next-auth.session-token 을
# 읽는다(next-auth/jwt/index.js:65). 운영 배포에서 이 값을 http 로 두거나 비워 두면
# getToken 이 언제나 null 을 돌려주어 로그인한 사용자 전원이 조용히 익명이 된다. 예외도
# 경고 로그도 남지 않고 「로그인했는데 대화 목록이 비어 있다」로만 나타난다.
NEXTAUTH_URL=http://localhost:3500
# openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-generate-with-openssl

# === Admin Config ===
# 쉼표 구분 ADMIN 이메일 목록 (이 이메일로 로그인한 사용자만 데이터 업데이트 가능)
ADMIN_EMAILS=admin@example.com

# Next.js 라우트 핸들러가 관리자 세션을 확인한 뒤 Flask 로 붙이는 서버 전용 토큰.
# npm dev/build/start 의 run-next.js가 필요한 서버 키만 Next에 전달한다.
# 루트 .env를 frontend에 통째로 링크하지 않는다. ADMIN_API_TOKEN은 Next에도 필요하다.
# 비어 있으면 /api/system/env 는 모든 요청을 403 으로 막는다.
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# NEXT_PUBLIC_ 접두사를 붙이지 않는다. 붙이면 브라우저 번들에 실려 게이트가 무의미해진다.
ADMIN_API_TOKEN=

# frontend/src/proxy.ts 가 NextAuth 세션을 확인한 뒤 붙이는 신원 서명을, Flask 가 검증할 때
# 쓰는 서버 전용 공유 비밀. ADMIN_API_TOKEN 과 나눠 둔다. 하나로 합치면 관리자 토큰이 새는
# 순간 아무 사용자로나 행세하는 것까지 가능해진다.
# 비어 있으면 모든 요청이 익명으로 처리되어 챗봇 소유자 판정과 AI 분석이 막히고,
# 설정 화면의 알림 테스트 발송도 관리자 판정에서 떨어져 403 이 된다.
# 생성: openssl rand -hex 32
# NEXT_PUBLIC_ 접두사를 붙이지 않는다. 붙이면 브라우저 번들에 실려 게이트가 무의미해진다.
INTERNAL_IDENTITY_SECRET=

# Scheduler Time Configuration (HH:MM format)
CLOSING_SCHEDULE_TIME=17:00  # 장 마감 데이터 → VCP → 종가베팅 체인 (기본: 17:00 KST)

# KRX 데이터 포털 로그인 (실제 계정 정보는 .env에만 입력)
KRX_ID=
KRX_PW=
