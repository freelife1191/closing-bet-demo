+    def _request(self, method: str, url: str, headers: dict = None, **kwargs):
+        request_headers = self.get_headers()
+        if headers is not None:
+            request_headers.update(headers)
+        if not is_krx_origin(url):
+            return public_request(method, url, request_headers, **kwargs)
+        # CookieJar enforces domain/path/secure; never rebuild a raw Cookie header.
+        # Do not let callers opt back into cross-origin authenticated redirects.
+        kwargs["allow_redirects"] = False
+        return self.session.request(method, url, headers=request_headers, **kwargs)
